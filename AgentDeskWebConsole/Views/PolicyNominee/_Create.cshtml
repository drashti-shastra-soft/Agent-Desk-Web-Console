@model AgentDeskWebConsole.Domain.PolicyNominee

<div class="modal fade" id="modal-policyNominee" tabindex="-1" aria-labelledby="policyNomineeModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="policyNomineelLabel">Edit Policy Nominee</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="policyNomineeModalLabel">Add Policy Nominee</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.PolicyId)

                <div class="row mb-2">
                    <div class="col">
                        <label>Name <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Age <span class="text-danger">*</span> </label>
                        @Html.TextBoxFor(m => m.Age, new { @class = "form-control", placeholder = "Enter Age" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Relation <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Relation, new { @class = "form-control", placeholder = "Enter Relation" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Nominee Percentage </label>
                        @Html.TextBoxFor(m => m.NomineePercentage, new { @class = "form-control", placeholder = "Enter Nominee Percentage" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/policy-nominee/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)