<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title | AgentDesk </title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">

    <!-- Font Awesome -->
    <link href="@Url.Content("~/Content/pluggins/fontawesome/all.min.css")" rel="stylesheet" />

    <!-- daterangepicker -->
    <link href="@Url.Content("~/Content/pluggins/daterangepicker/daterangepicker.css")" rel="stylesheet" />

    <!-- tempusdominus -->
    <link href="@Url.Content("~/Content/pluggins/daterangepicker/tempusdominus-bootstrap-4.min.css")" rel="stylesheet" />

    <!-- Toastr -->
    <link href="@Url.Content("~/Scripts/plugins/toastr/toastr.min.css")" rel="stylesheet" />

    <!--  dropzone-->
    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/dropzone/min/dropzone.min.css")" />

    <!-- Theme style -->
    <link rel="stylesheet" href="@Url.Content("~/Content/dist/adminlte.min.css")">

    <!-- Custom -->
    <link href="@Url.Content("~/Content/css/custom.css")" rel="stylesheet" />

    <!-- jQuery -->
    <script src="@Url.Content("~/Scripts/plugins/jquery/jquery.min.js")"></script>

    <!-- Bootstrap 4 -->
    <script src="@Url.Content("~/Scripts/plugins/bootstrap/bootstrap.bundle.min.js")"></script>

    <!-- moment  -->
    <script src="@Url.Content("~/Content/pluggins/daterangepicker/moment.min.js")"></script>

    <!-- tempusdominus  -->
    <script src="@Url.Content("~/Content/pluggins/daterangepicker/tempusdominus-bootstrap-4.min.js")"></script>

    <!-- daterangepicker  -->
    <script src="@Url.Content("~/Content/pluggins/daterangepicker/daterangepicker.js")"></script>

    <!-- dropzone  -->
    <script src="@Url.Content("~/Scripts/plugins/dropzone/min/dropzone.min.js")"></script>

    <!-- Toastr -->
    <script src="@Url.Content("~/Scripts/plugins/toastr/toastr.min.js")"></script>

    <!-- AdminLTE App -->
    <script src="@Url.Content("~/Scripts/dist/js/adminlte.min.js")"></script>

    <!-- Unobtrusive -->
    <script src="@Url.Content("~/Scripts/jquery.unobtrusive-ajax.min.js")"></script>

    <!-- Masking -->
    <script src="@Url.Content("~/Scripts/jquery.mask.min.js")"></script>

    <!-- custom notification -->
    <script src="@Url.Content("~/Scripts/js/custom-notification.js")"></script>

    <!-- functions -->
    <script src="@Url.Content("~/Scripts/js/custom-functions.js")"></script>

    <!-- custom event -->
    <script src="@Url.Content("~/Scripts/js/custom-document-event.js")"></script>
</head>
<body class="hold-transition sidebar-mini">
    <!-- Site wrapper -->
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="@Url.Action("Index", "Dashboard")" class="brand-link">
                <img src="@Url.Content("~/Content/Image/AdminLTELogo.png")" alt="AgentDesk" class="brand-image img-circle elevation-3" style="opacity: .8">
                <img src="" />
                <span class="brand-text font-weight-light">AgentDesk</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar user (optional) -->
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Dashboard")" class="nav-link @(ViewBag.Title == "Dashboard" ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p> Dashboard </p>
                            </a>
                        </li>
                        @if (AgentDeskWebConsole.Infrastructure.StaticMethods.IsSystemOwner())
                        {
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Company")" class="nav-link @(ViewBag.Title == "Company" ? "active" : "")">
                                <i class="nav-icon fas fa-solid fa-building"></i>
                                <p>
                                    Company
                                </p>
                            </a>
                        </li>
                        }
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "User")" class="nav-link @(ViewBag.Title == "User" ? "active" : "")">
                                <i class="nav-icon fas fa-solid fa-users"></i>
                                <p>
                                    User
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Group")" class="nav-link @(ViewBag.Title == "Group" ? "active" : "")">
                                <i class="nav-icon fas fa-user-friends"></i>
                                <p>
                                    Group
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Agency")" class="nav-link @(ViewBag.Title == "Agency" ? "active" : "")">
                                <i class="nav-icon fas fa-hospital-user"></i>
                                <p>
                                    Agency
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Client")" class="nav-link @(ViewBag.Title == "Client" ? "active" : "")">
                                <i class="nav-icon fas fa-solid fa-user"></i>
                                <p>
                                    Client
                                </p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Policy")" class="nav-link @(ViewBag.Title == "Policy" ? "active" : "")">
                                <i class="nav-icon fas fa-file-medical-alt"></i>
                                <p>
                                    Policy
                                </p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "PremiumReport")" class="nav-link @(ViewBag.Title == "Premium Report" ? "active" : "")">
                                <i class="nav-icon fas fa-money-bill"></i>
                                <p>
                                    Premium Report
                                </p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "ImportLI")" class="nav-link @(ViewBag.Title == "ImportLI" ? "active" : "")">
                                <i class="nav-icon fas fa-file-import"></i>
                                <p>
                                    ImportLI
                                </p>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a href="@Url.Action("Index", "ChangePassword")" class="nav-link @(ViewBag.Title == "ChangePassword" ? "active" : "")">
                                <i class="nav-icon fas fa-unlock-alt"></i>
                                <p>
                                    Change Password
                                </p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="@Url.Action("Index", "Logout")" class="nav-link">
                                <i class="nav-icon fas fa-solid fa-sign-out-alt"></i>
                                <p>
                                    Logout
                                </p>
                            </a>
                        </li>
                    </ul>
                </nav>
                <!-- /.sidebar-menu -->
            </div>
            <!-- /.sidebar -->
        </aside>
        @RenderBody()
        <div id="loading-element" class="custom-loader">
            <div class="loader">
                <img src="@Url.Content("~/Content/Image/loading.gif")" style="height:100px;" />
            </div>
            <br />
        </div>

        <footer class="main-footer">
            <div class="float-right d-none d-sm-block">
                <b>Version</b> 1.0.0
            </div>
            <strong>Copyright &copy; 2026-2027 <a href="javascript:void(0)">Agent Desk</a>.</strong> All rights reserved.
        </footer>

        <!-- Control Sidebar -->
        <aside class="control-sidebar control-sidebar-dark">
            <!-- Control sidebar content goes here -->
        </aside>
        <!-- /.control-sidebar -->
    </div>
    <!-- ./wrapper -->


</body>
</html>

