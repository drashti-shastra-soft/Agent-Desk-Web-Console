@model List<AgentDeskWebConsole.Domain.Report>

@{
    ViewBag.Title = "Premium Report";
}

<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "PremiumReport")">Home</a></li>
                        <li class="breadcrumb-item active">Premium Report</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header">

                </div>

                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Policy Number</th>
                                <th>Policy Type</th>
                                <th>Area</th>
                                <th>FUP Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                string previousArea = "";
                            }

                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Client</td>
                                        <td>@item.PolicyNumber</td>
                                        <td>@item.PolicyType</td>

                                        <td>
                                            @if (previousArea != item.Area)
                                            {
                                                @item.Area
                                                previousArea = item.Area;
                                            }
                                        </td>
                                        <td>@item.FUPDate.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td class="text-center text-danger" colspan="5">
                                        There is currently no content to display
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>