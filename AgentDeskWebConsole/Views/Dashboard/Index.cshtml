@model List<AgentDeskWebConsole.Domain.Policy>

@{
    ViewBag.Title = "Dashboard";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="row">
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3 id="lifeCount">0</h3>

                        <p>Life Insurance</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <a href="@Url.Action("Index", "Report", new { type = "Life" })" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3 id="healthCount">0</h3>

                        <p>Health Insurance</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-user-injured"></i>
                    </div>
                    <a href="@Url.Action("Index", "Report", new { type = "Health" })" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3 id="propertyCount">0</h3>

                        <p>Property Insurance</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-home"></i>
                    </div>
                    <a href="@Url.Action("Index", "Report", new { type = "Property" })" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-3 col-6">
                <!-- small box -->
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3 id="vehicleCount">0</h3>

                        <p>Vehicle Insurance</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-car"></i>
                    </div>
                    <a href="@Url.Action("Index", "Report", new { type = "Vehicle" })" class="small-box-footer">More info <i class="fas fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <!-- ./col -->
        </div>
        <div class="row">
            <!-- Default box -->
            <div class="col-md-3">
                <div class="card">
                    <div class="card-header border-0 text-center">
                        <h3 class="card-title">Life Insurance</h3>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-striped table-valign-middle">
                            <thead>
                                <tr>
                                    <th>
                                        Name
                                    </th>
                                    <th>
                                        FUP Date
                                    </th>
                                    <th>
                                        Premium Amount
                                    </th>
                                    <th>
                                        Mode
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="bodyLIC">
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <img src="~/Content/Image/loader.gif" width="75">
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <a href="@Url.Action("Index", "Report", new { type = "Life" })" class="btn btn-primary btn-sm btn-view-more"> View More </a>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /.card -->
            <!-- Default box -->
            <div class="col-md-3">
                <div class="card">
                    <div class="card-header border-0 text-center">
                        <h3 class="card-title">Health Insurance</h3>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-striped table-valign-middle">
                            <thead>
                                <tr>
                                    <th>
                                        Name
                                    </th>
                                    <th>
                                        FUP Date
                                    </th>
                                    <th>
                                        Premium Amount
                                    </th>
                                    <th>
                                        Mode
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="bodyHealth">
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <img src="~/Content/Image/loader.gif" width="75">
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <a href="@Url.Action("Index", "Report", new { type = "Health" })" class="btn btn-primary btn-sm btn-view-more"> View More </a>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
            <!-- /.card -->
            <!-- Default box -->
            <div class="col-md-3">
                <div class="card">
                    <div class="card-header border-0 text-center">
                        <h3 class="card-title">Property Insurance</h3>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-striped table-valign-middle">
                            <thead>
                                <tr>
                                    <th>
                                        Name
                                    </th>
                                    <th>
                                        FUP Date
                                    </th>
                                    <th>
                                        Premium Amount
                                    </th>
                                    <th>
                                        Mode
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="bodyGeneral">
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <img src="~/Content/Image/loader.gif" width="75">
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <a href="@Url.Action("Index", "Report", new { type = "Property" })" class="btn btn-primary btn-sm btn-view-more"> View More </a>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card">
                    <div class="card-header border-0 text-center">
                        <h3 class="card-title">Vehicle Insurance</h3>
                    </div>
                    <div class="card-body table-responsive p-0">
                        <table class="table table-striped table-valign-middle">
                            <thead>
                                <tr>
                                    <th>
                                        Name
                                    </th>
                                    <th>
                                        FUP Date
                                    </th>
                                    <th>
                                        Premium Amount
                                    </th>
                                    <th>
                                        Mode
                                    </th>
                                </tr>
                            </thead>
                            <tbody id="bodyVehicle">
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <img src="~/Content/Image/loader.gif" width="75">
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="text-center">
                                        <a href="@Url.Action("Index", "Report", new { type = "Vehicle" })" class="btn btn-primary btn-sm btn-view-more"> View More </a>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- /.row -->
        <!-- /.card -->
    </section>
    <!-- /.content -->
</div>
<!-- /.content-wrapper -->

<script>

    $(document).ready(function () {

        getDashboardCounts();

        fnGetLifeInsuranceRenewal();
        fnGetHealthInsuranceRenewal();
        fnGetPropertyInsuranceRenewal();
        fnGetVehicleInsuranceRenewal();

    });

    function getDashboardCounts() {
        $.ajax({
            url: '/Dashboard/GetDashboardCounts',
            type: 'GET',
            success: function (data) {

                $("#lifeCount").text(data.LifeCount);
                $("#healthCount").text(data.HealthCount);
                $("#propertyCount").text(data.PropertyCount);
                $("#vehicleCount").text(data.VehicleCount);

            },
            error: function () {
                console.log("Failed to load dashboard counts.");
            }
        });
    }

    function fnGetLifeInsuranceRenewal() {

        $.ajax({
            url: '/Dashboard/GetLifeInsuranceRenewal',
            type: 'GET',
            success: function (data) {
                $("#bodyLIC").html(data);
            },
            error: function () {
                $("#bodyLIC").html("<tr><td colspan='4'>Error loading data</td></tr>");
            }
        });

    }

    function fnGetHealthInsuranceRenewal() {

        $.ajax({
            url: '/Dashboard/GetHealthInsuranceRenewal',
            type: 'GET',
            success: function (data) {
                $("#bodyHealth").html(data);
            },
            error: function () {
                $("#bodyHealth").html("<tr><td colspan='4'>Error loading data</td></tr>");
            }
        });

    }

    function fnGetPropertyInsuranceRenewal() {

        $.ajax({
            url: '/Dashboard/GetPropertyInsuranceRenewal',
            type: 'GET',
            success: function (data) {
                $("#bodyGeneral").html(data);
            },
            error: function () {
                $("#bodyGeneral").html("<tr><td colspan='4'>Error loading data</td></tr>");
            }
        });

    }

    function fnGetVehicleInsuranceRenewal() {
        $.ajax({
            url: '/Dashboard/GetVehicleInsuranceRenewal',
            type: 'GET',
            success: function (data) {
                $("#bodyVehicle").html(data);
            },
            error: function () {
                $("#bodyVehicle").html("<tr><td colspan='4'>Error loading data</td></tr>");
            }
        });

    }

</script>