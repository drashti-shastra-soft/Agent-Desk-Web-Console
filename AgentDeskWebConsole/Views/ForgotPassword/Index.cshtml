@model AgentDeskWebConsole.Domain.ForgotPassword
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Authentication | AgentDesk</title>

    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="@Url.Content("~/Content/pluggins/fontawesome/all.min.css")">

    <!--- Toastr -->
    <link rel="stylesheet" href="@Url.Content("~/Scripts/plugins/toastr/toastr.min.css")">

    <!-- Theme style -->
    <link rel="stylesheet" href="@Url.Content("~/Content/dist/adminlte.min.css")">

    <!-- icheck bootstrap -->
    <link rel="stylesheet" href="@Url.Content("~/Content/pluggins/icheck-bootstrap/icheck-bootstrap.min.css")">

    <!-- style style -->
    <link rel="stylesheet" href="@Url.Content("~/Content/css/custom.css")">

</head>
<body class="login-page bg-body-secondary externalBody">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="javascript:void(0);" class="h1"><b>Agent Desk</b></a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Reset your password to continue</p>

                @using (Html.BeginForm("Index", "ForgotPassword", FormMethod.Post, new { id = "frmForgotPassword" }))
                {
                    <div class="LoginFormSection">
                        <div class="input-group mb-3">
                            @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", placeholder = "Email Address" })
                            <span class="text-danger d-none"></span>
                            <div class="input-group-text"><span class="fas fa-envelope"></span></div>
                        </div>
                        <div class="row align-items-center">
                            <div class="col-6">
                                <p class="mb-1"><a href="@Url.Action("Index", "Authentication")">Back To Login Page</a></p>
                            </div>
                            <div class="col-6">
                                <div class="d-grid gap-2 text-right">
                                    <a href="javascript:void(0);" class="btn btn-primary btn-submit">Forgot Password</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- jQuery -->
    <script src="@Url.Content("~/Scripts/plugins/jquery/jquery.min.js")"></script>

    <!-- Bootstrap 4 -->
    <script src="@Url.Content("~/Scripts/plugins/bootstrap/bootstrap.bundle.min.js")"></script>

    <!-- AdminLTE App -->
    <script src="@Url.Content("~/Scripts/dist/js/adminlte.min.js")"></script>

    <!-- Toastr -->
    <script src="@Url.Content("~/Scripts/plugins/toastr/toastr.min.js")"></script>

    <!-- Custom Notification -->
    <script src="@Url.Content("~/Scripts/js/custom-notification.js")"></script>

    <!-- Custom Functions -->
    <script src="@Url.Content("~/Scripts/js/custom-functions.js")"></script>

    <!-- custom event -->
    <script src="@Url.Content("~/Scripts/js/custom-document-event.js")"></script>

    <!-- Custom Js -->
    <script src="@Url.Content("~/custom-js/forgot-password/Index.js")"></script>

    @Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
    @Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)
</body>
</html>
