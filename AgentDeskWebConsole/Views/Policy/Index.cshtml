@model AgentDeskWebConsole.Domain.PolicyLister
@{
    ViewBag.Title = "Policy";
}

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Dashboard")">Home</a></li>
                        @*<li class="breadcrumb-item"><a href="@Url.Action("Index", "Client")">Client</a></li>*@
                        <li class="breadcrumb-item active">Policy</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <!-- Default box -->
        <div class="card">
            @using (Ajax.BeginForm("List", "Policy", new AjaxOptions() { UpdateTargetId = "divList", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmList" }))
             {
                @Html.HiddenFor(m => m.SearchCriteria.ClientId, new { id = "ClientId" })
                <div id="divList">
                    @Html.Action("List", Model)
                </div>
             }
        </div>
        <!-- /.card -->
        <!-- Default box -->
        <div class="card">
            @using (Ajax.BeginForm("Create", "Policy", new AjaxOptions() { UpdateTargetId = "divCreate", InsertionMode = InsertionMode.Replace, LoadingElementId = "loading-element" }, new { @id = "frmCreate", enctype = "multipart/form-data" }))
             {
                <div id="divCreate"></div>
             }
        </div>
        <!-- /.card -->
    </section>
    <!-- /.content -->
</div>
<!-- /.content-wrapper -->
