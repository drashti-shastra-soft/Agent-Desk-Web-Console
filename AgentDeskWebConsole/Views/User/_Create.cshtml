@model AgentDeskWebConsole.Domain.User

<div class="modal fade" id="modal-user" tabindex="-1" aria-labelledby="UserModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="UserModalLabel">Edit User</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="UserModalLabel">Add User</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)


                @if (ViewBag.ShowCompany == true)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <label> Company </label>
                            @Html.DropDownListFor(m => m.CompanyId, ViewBag.Companies as List<SelectListItem>, "Select Company", new { @class = "form-control" })
                        </div>
                    </div>
                }

                    <div class="row mb-2">
                        <div class="col">
                            <label>First Name <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", placeholder = "Enter First Name" })
                            <span class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label>Last Name<span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", placeholder = "Enter Last Name" })
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col">
                            <label>Email Address <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", placeholder = "Enter Email Address" })
                            <span class="text-danger"></span>
                        </div>

                        <div class="col">
                            <label>Mobile Number <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.MobileNumber, new { @class = "form-control", placeholder = "Enter Mobile Number" })
                            <span class="text-danger"></span>
                        </div>
                        @Html.HiddenFor(m => m.Password)
                    </div>

                    <div class="row mb-2">
                        <div class="col-6">
                            <label>Role <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.RoleId, ViewBag.Roles as List<SelectListItem>, "Select Role", new { @class = "form-control" })
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-2">
                        <div class="col">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                                <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                            </div>
                        </div>
                    </div>
                </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/custom-js/user/create.js")"></script>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)
